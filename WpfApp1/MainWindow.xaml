<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Управление сотрудниками" 
        Height="800" Width="1200">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dataGrid" 
                  Grid.Column="0"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="0,0,10,210"
                  ItemsSource="{Binding employees}"
                  Grid.RowSpan="2"
                  SelectedItem="{Binding SelectedEmployee}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="FullName" Binding="{Binding FullName}" Width="150"/>
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="100"/>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="ExperienceYears" Binding="{Binding ExperienceYears}" Width="100"/>
                <DataGridTextColumn Header="Language" Binding="{Binding Language.Name}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>





        <StackPanel 
            Grid.Column="1"
            Grid.Row="0"
            Margin="0,0,0,20">
            <Button x:Name="add_btn" Content="Добавить" Height="40" Command="{Binding commandAdd}"/>
            <Button x:Name="update_btn" Content="Изменить" Height="40" Margin="0,0,0,5" Command="{Binding commandUpdate}"/>
            <Button x:Name="delete_btn" Content="Удалить" Height="40" Margin="0,0,0,5" Command="{Binding commandDelete}"/>
            <Button x:Name="up_btn" Content="Повышение" Height="40" Command="{Binding commandPromote}"/>
        </StackPanel>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBox Grid.Column="1" Grid.Row="0" Margin="20,5,0,0" Width="300" Height="30" Text="{Binding Name}"/>
            <TextBox Grid.Column="1" Grid.Row="3" Margin="20,5,0,0" Width="300" Height="30" Text="{Binding Salary}"/>
            <TextBox Grid.Column="1" Grid.Row="4" Margin="20,5,0,0" Width="300" Height="30" Text="{Binding Expirience}"/>
            <TextBlock Text="ФИО" FontSize="20" Grid.Column="0" Grid.Row="0" Margin="20,5,0,0" Width="300" Height="30"/>
            <TextBlock Text="Уровень.Проф развития" FontSize="20" Grid.Column="0" Grid.Row="1" Margin="20,5,0,0" Width="300" Height="30"/>
            <TextBlock Text="Отдел" FontSize="20" Grid.Column="0" Grid.Row="2" Margin="20,5,0,0" Width="300" Height="30"/>
            <TextBlock Text="Язык программирования" FontSize="20" Grid.Column="0" Grid.Row="5" Margin="20,5,0,0" Width="300" Height="30"/>
            <ComboBox Grid.Column="1" Grid.Row="1" Margin="20,5,0,0" Width="300" Height="30" SelectedIndex="{Binding PositionEmployee}">
                <ComboBoxItem Content="Unknow"/>
                <ComboBoxItem Content="Junior"/>
                <ComboBoxItem Content="Middle"/>
                <ComboBoxItem Content="Senior"/>
            </ComboBox>
            <ComboBox Grid.Column="1" Grid.Row="2" Margin="20,5,0,0" Width="300" Height="30" SelectedIndex="{Binding DepartmentEmployee}">
                <ComboBoxItem Content="Unknown"/>
                <ComboBoxItem Content="Аналитик"/>
                <ComboBoxItem Content="Кибербезопасность"/>
                <ComboBoxItem Content="Информационная_структура"/>
                <ComboBoxItem Content="Разработчик"/>
                <ComboBoxItem Content="ERP_платформы"/>
                <ComboBoxItem Content="База_данных"/>
            </ComboBox>
            <TextBlock Text="Зарплата" FontSize="20" Grid.Column="0" Grid.Row="3" Margin="20,5,0,0" Width="300" Height="30"/>
            <TextBlock Text ="Опыт работы" FontSize="20" Grid.Column="0" Grid.Row="4" Margin="20,5,0,0" Width="300" Height="30"/>
            <ComboBox Grid.Column="1" Grid.Row="5" Margin="20,5,0,0" Width="300" Height="30" SelectedItem="{Binding Language, Mode=TwoWay}">
                <ComboBoxItem Content="Unknow" IsSelected="True"/>
                <ComboBoxItem Content="Go"/>
                <ComboBoxItem Content="C#"/>
                <ComboBoxItem Content="JavaScript"/>
                <ComboBoxItem Content="Python"/>
                <ComboBoxItem Content="TypeScript"/>
                <ComboBoxItem Content="Java"/>
                <ComboBoxItem Content="Rust"/>
                <ComboBoxItem Content="SQL"/>
            </ComboBox>



        </Grid>
        <Border Grid.Column="0" Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Background="White" Padding="10">
            <StackPanel >


                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10" >
                    <CheckBox x:Name="checkBox1" Content="Вывести всех сотрудников" FontSize="14" IsChecked="{Binding ShowAll}"/>
                </Border>


                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="checkBox2" Content="Вывести сотрудников по позиции" FontSize="14" IsChecked="{Binding ShowOnPosition}"/>
                        <ComboBox x:Name="comboBox1" Margin="20,5,0,0" Width="300" Height="30" SelectedIndex="{Binding PositionChoose}">
                            <ComboBoxItem Content="Unknow"/>
                            <ComboBoxItem Content="Junior"/>
                            <ComboBoxItem Content="Middle"/>
                            <ComboBoxItem Content="Senior"/>
                        </ComboBox>
                    </StackPanel>
                </Border>


                <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="checkBox3" Content="Вывести сотрудников по отделу" FontSize="14" IsChecked="{Binding ShowOnDepartment}"/>
                        <ComboBox x:Name="comboBox2" Margin="20,5,0,0" Width="300" Height="30" SelectedIndex="{Binding DepartmentChoose}">
                            <ComboBoxItem Content="Unknown"/>
                            <ComboBoxItem Content="Аналитик"/>
                            <ComboBoxItem Content="Кибербезопасность"/>
                            <ComboBoxItem Content="Информационная_структура"/>
                            <ComboBoxItem Content="Разработчик"/>
                            <ComboBoxItem Content="ERP_платформы"/>
                            <ComboBoxItem Content="База_данных"/>
                        </ComboBox>
                    </StackPanel>
                </Border>


                <Border Padding="0,0,0,10">
                    <CheckBox x:Name="checkBox4" Content="Вывести сотрудников на повышение" FontSize="14" IsChecked="{Binding ShowOnPromote}"/>
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</Window>